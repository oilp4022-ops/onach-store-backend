{
  "name": "onach-urban-store",
  "version": "0.2.0",
  "description": "Onach Urban Store - API REST y frontend de comercio electrónico de ropa urbana",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node --test --test-reporter=spec \"tests/unit/*.test.js\" \"tests/integration/*.test.js\"",
    "test:unit": "node --test --test-reporter=spec \"tests/unit/*.test.js\"",
    "test:integration": "node --test --test-reporter=spec \"tests/integration/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=\"app.js\" --test-coverage-include=\"controllers/**\" --test-coverage-include=\"routes/**\" --test-coverage-include=\"middlewares/**\" --test-coverage-include=\"utils/**\" --test-coverage-lines=60 --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info \"tests/unit/*.test.js\" \"tests/integration/*.test.js\"",
    "test:e2e": "node --test --test-reporter=spec \"tests/e2e/*.test.js\"",
    "validar": "node scripts/validar.js",
    "ci:local": "bash scripts/ci-local.sh"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.3.2",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.14.3",
    "nodemailer": "^8.0.4"
  }
}
