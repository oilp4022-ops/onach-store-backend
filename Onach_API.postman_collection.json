{
  "info": {
    "name": "Onach Urban Store API - Seguridad",
    "description": "Endpoints de autenticación, MFA y productos para el proyecto Onach.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Registrar Usuario",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "http://127.0.0.1:3006/api/register",
          "host": [
            "http://127.0.0.1:3006"
          ],
          "path": [
            "api",
            "register"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n    \"nombre\": \"Oscar\",\n    \"apellido\": \"Ivan\",\n    \"email\": \"prueba@onach.com\",\n    \"password\": \"123456\"\n}"
        }
      }
    },
    {
      "name": "2. Login (Paso 1 - Generar MFA)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "http://127.0.0.1:3006/api/login",
          "host": [
            "http://127.0.0.1:3006"
          ],
          "path": [
            "api",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n    \"email\": \"prueba@onach.com\",\n    \"password\": \"123456\"\n}"
        }
      }
    },
    {
      "name": "3. Verificar MFA (Paso 2)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "http://127.0.0.1:3006/api/verify-mfa",
          "host": [
            "http://127.0.0.1:3006"
          ],
          "path": [
            "api",
            "verify-mfa"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n    \"userId\": 1,\n    \"mfaCode\": \"123456\"\n}"
        }
      }
    },
    {
      "name": "4. Obtener Sesiones Activas",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer TU_TOKEN_AQUI"
          }
        ],
        "url": {
          "raw": "http://127.0.0.1:3006/api/sessions",
          "host": [
            "http://127.0.0.1:3006"
          ],
          "path": [
            "api",
            "sessions"
          ]
        }
      }
    },
    {
      "name": "5. Recuperar Contraseña (Enviar Correo)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "http://127.0.0.1:3006/api/forgot-password",
          "host": [
            "http://127.0.0.1:3006"
          ],
          "path": [
            "api",
            "forgot-password"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n    \"email\": \"prueba@onach.com\"\n}"
        }
      }
    },
    {
      "name": "V1 Seguridad y Maestro-Detalle",
      "item": [
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "refresh"
              ]
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "logout"
              ]
            }
          }
        },
        {
          "name": "Listar variantes",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/products/1/variants",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products",
                "1",
                "variants"
              ]
            }
          }
        },
        {
          "name": "Crear variante",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"talla\": \"M\",\n  \"stock\": 20\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/products/1/variants",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products",
                "1",
                "variants"
              ]
            }
          }
        },
        {
          "name": "Actualizar variante",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"talla\": \"M\",\n  \"stock\": 25\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/products/1/variants/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products",
                "1",
                "variants",
                "1"
              ]
            }
          }
        },
        {
          "name": "Eliminar variante",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/products/1/variants/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products",
                "1",
                "variants",
                "1"
              ]
            }
          }
        }
      ]
    }
  ]
}